@model QuanLyNet.Models.Computer
@using QuanLyNet.Models 

@{
    ViewData["Title"] = "Chỉnh sửa máy tính";
}

<h1>@ViewData["Title"]: @Model.Name</h1>
<hr />

<div class="row">
    <div class="col-md-6">
        <form asp-action="EditComputer" asp-route-id="@Model.ID" method="post">
            <div asp-validation-summary="All" class="text-danger"></div> 

            <input type="hidden" asp-for="ID" /> 

            <div class="mb-3">
                <label asp-for="Name" class="form-label"></label>
                <input asp-for="Name" class="form-control" />
                <span asp-validation-for="Name" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="Price" class="form-label">Giá/giờ (VNĐ)</label>
                <input asp-for="Price" class="form-control" type="number" min="1000" step="1000" />
                <span asp-validation-for="Price" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="Status" class="form-label"></label>
                @if (Model.Status == ComputerStatus.InUse)
                {
                    <input type="text" class="form-control" value="@Model.Status" readonly title="Không thể sửa trạng thái máy đang sử dụng" />
                    <input type="hidden" asp-for="Status" /> 
                }
                else
                {
                    <select asp-for="Status" asp-items="Html.GetEnumSelectList<ComputerStatus>()" class="form-select">
                    </select>
                }
                <span asp-validation-for="Status" class="text-danger"></span>
            </div>

            <div class="d-flex gap-2">
                <button type="submit" class="btn btn-primary">Lưu thay đổi</button>
                <a asp-action="ComputerManagement" class="btn btn-secondary">Hủy</a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}