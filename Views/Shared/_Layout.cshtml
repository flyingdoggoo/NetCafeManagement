@using Microsoft.AspNetCore.Http
@using QuanLyNet.Controllers.Account
@inject IHttpContextAccessor Accessor
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"]HiếuPro Net Gaming</title>
    <script type="importmap"></script>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/QuanLyNet.styles.css" asp-append-version="true" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.7.2/css/all.min.css" integrity="sha512-Evv84Mr4kqVGRNSgIGL/F/aIDqQb7xQ2vcrdIwxfjThSH8CSR7PBEakCr51Ck+w+/U6swU2Im1vVX0SVk9ABhg==" crossorigin="anonymous" referrerpolicy="no-referrer" />
</head>
<body>
    <header>
        <nav class="navbar navbar-expand-sm navbar-toggleable-sm navbar-light bg-white border-bottom box-shadow mb-3">
            <div class="container-fluid">
                <a class="navbar-brand fw-bold" asp-area="" asp-controller="Home" asp-action="Index">HiếuPro Net Gaming</a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target=".navbar-collapse" aria-controls="navbarSupportedContent"
                        aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="navbar-collapse collapse d-sm-inline-flex justify-content-between">
                    <ul class="navbar-nav me-auto mb-2 mb-lg-0">
                        <li class="nav-item fw-bold">
                            <a class="nav-link text-dark" asp-area="" asp-controller="Home" asp-action="Index">Trang chủ</a>
                        </li>
                        <li class="nav-item fw-bold">
                            <a class="nav-link text-dark" asp-area="" asp-controller="Home" asp-action="Privacy">Quy định của quán</a>
                        </li>
                    </ul>
                    <ul class="navbar-nav d-flex align-items-center">
                        @{
                            var username = Accessor.HttpContext?.Session.GetString(AccountController.SessionKeyUsername);
                            var isAdmin = Accessor.HttpContext?.Session.GetString(AccountController.SessionKeyIsAdmin) == "True";
                            var balanceString = Accessor.HttpContext?.Session.GetString(AccountController.SessionKeyUserBalance);
                            string formattedBalance = "0"; 
                            if (decimal.TryParse(balanceString, out decimal balanceValue)) 
                            {
                                formattedBalance = balanceValue.ToString("N0"); 
                            }
                        }
                        @if(username != null)
                        {
                            <li class="nav-item fw-bold">
                                <span class="navbar-text text-dark me-3">Chào, @username!</span>
                            </li>
                            <li class="nav-item fw-bold">
                                <span class="navbar-text me-3">
                                    <i class="fas fa-wallet text-warning"></i> @* Thêm icon ví (cần FontAwesome) *@
                                    <span class="text-warning fw-bold">Số dư: @formattedBalance đ</span>
                                </span>
                            </li>
                            @if (isAdmin) 
                            {
                                <li class="nav-item dropdown fw-bold">
                                    <a class="nav-link dropdown-toggle text-primary" href="#" role="button" data-bs-toggle="dropdown" aria-expanded="false">
                                        Trang Admin
                                    </a>
                                    <ul class="dropdown-menu fw-bold">
                                        <li>
                                            <a class="dropdown-item" asp-area="" asp-controller="User" asp-action="Profile">Hồ sơ</a> 
                                        </li>
                                        <li><hr class="dropdown-divider"></li>
                                        <li>
                                            <a class="dropdown-item" asp-area="" asp-controller="Admin" asp-action="UserManagement">Quản lý khách</a>
                                        </li>
                                        <li>
                                            <a class="dropdown-item" asp-area="" asp-controller="Admin" asp-action="ComputerManagement">Quản lý máy</a>
                                        </li>
                                        <li><hr class="dropdown-divider"></li>
                                        <li>
                                            <a class="dropdown-item" asp-area="" asp-controller="Admin" asp-action="BillManagement">Thống kê</a>
                                        </li>
                                    </ul>
                                </li>
                            }
                            else 
                            {
                                <li class="nav-item dropdown">
                                    <a class="nav-link dropdown-toggle text-primary fw-bold" href="#" role="button" data-bs-toggle="dropdown" aria-expanded="false">
                                        Trang User
                                    </a>
                                    <ul class="dropdown-menu">
                                        <li>
                                            <a class="dropdown-item" asp-area="" asp-controller="User" asp-action="Profile">Hồ sơ</a>
                                        </li>
                                        <li>
                                            <a class="dropdown-item" asp-area="" asp-controller="Bill" asp-action="SelectComputer">Chọn máy chơi</a> 
                                        </li>
                                        <li><hr class="dropdown-divider"></li>
                                        <li><a class="dropdown-item" asp-area="" asp-controller="User" asp-action="PaymentHistory">Lịch sử Giao dịch</a></li>
                                           
                                    </ul>
                                </li>
                            }
                            <ul class="navbar-nav">
                                <li class="nav-item fw-bold">
                                    <form asp-controller="Account" asp-action="Logout" method="post" id="logoutForm" class="form-inline">
                                        <button type="submit" class="nav-link btn btn-link text-dark">Đăng xuất</button>
                                    </form>
                                </li>
                            </ul>
                        }
                        else
                        {
                            <li class="nav-item fw-bold">
                                <a class="nav-link text-dark" asp-area="" asp-controller="Account" asp-action="Register">Đăng ký</a> 
                             </li>
                            <li class="nav-item fw-bold">
                                <a class="nav-link text-dark" asp-area="" asp-controller="Account" asp-action="Login">Đăng nhập</a> 
                             </li> 
                        }
                    </ul>
                </div>
            </div>
        </nav>
    </header>
    <div class="container">
        <main role="main" class="pb-3">
            @if (TempData["SuccessMessage"] != null)
            {
                <div class="alert alert-success alert-dismissible fade show" role="alert">
                    @TempData["SuccessMessage"]
                    <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                </div>
            }
            @if (TempData["ErrorMessage"] != null)
            {
                <div class="alert alert-danger alert-dismissible fade show" role="alert">
                    @TempData["ErrorMessage"]
                    <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                </div>
            }
            @RenderBody()
        </main>
    </div>

    @* <footer class="border-top footer text-muted"> *@
    @*     <div class="container"> *@
    @*         &copy; 2025 - QuanLyNet - <a asp-area="" asp-controller="Home" asp-action="Privacy">Privacy</a> *@
    @*     </div> *@
    @* </footer> *@
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
